# Copia aquest fitxer com a .env només si ho necessites.
# PORT=3000
# Si la xarxa no deixa arribar a PokéAPI, engega npm run pokeapi-local
# i descomenta la línia següent:
# POKEAPI_URL=http://localhost:3999/api/v2
# Temps màxim d'espera a PokéAPI, en mil·lisegons (per defecte 5000)
# POKEAPI_TIMEOUT_MS=5000
